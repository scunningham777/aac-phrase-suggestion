# Copy to .env.local and fill in. Keep the key scoped to this project – a
# system-wide ANTHROPIC_API_KEY makes Claude Code bill the API instead of your plan.
ANTHROPIC_API_KEY=

# Optional: per-IP rate limiting for /api/suggest. Set automatically on Vercel
# when an Upstash Redis store is connected (Marketplace); the KV_REST_API_*
# names work too. Without them, rate limiting is off.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
